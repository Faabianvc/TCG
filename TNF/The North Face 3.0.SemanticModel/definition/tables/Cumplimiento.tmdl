	measure 'Tarea 9 Accesorios deportivos' =
			
			VAR cumplidas = CALCULATE(COUNTROWS(Cumplimiento), Cumplimiento[Cumplimiento tarea] = 1, Cumplimiento[departamento] = "Accesorios Deportivos")
