table Cumplimiento
	lineageTag: c7e3a1f2-4b8d-4e9a-a1c3-d2f5e6a7b8c9

	measure PorcentajeCumplimiento =
			
			VAR TotalTareas = [Tareas2] * DISTINCTCOUNT(dim_sucursales[id])
			VAR TareasCumplidas = CALCULATE(COUNTROWS(Cumplimiento), Cumplimiento[Cumplimiento tarea] = 1)
			RETURN CALCULATE(DIVIDE(TareasCumplidas, TotalTareas, 0), Cumplimiento[departamento])
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: a1b2c3d4-e5f6-7890-abcd-ef1234567001

	measure 'Tarea 2 Caballeros Lifestyle' =
			
			VAR cumplidas = CALCULATE(COUNTROWS(Cumplimiento), Cumplimiento[Cumplimiento tarea] = 1, Cumplimiento[departamento] = "Caballero Lifestyle")
			VAR total_tareas = [Tareas2] / 10
			RETURN IF(DIVIDE(cumplidas, total_tareas, 0) > 0, DIVIDE(cumplidas, total_tareas, 0), 0)
		formatString: 0\ %;-0\ %;0\ %
		lineageTag: a1b2c3d4-e5f6-7890-abcd-ef1234567002

	measure 'Tarea 3 Calzado Caballeros' =
			
			VAR cumplidas = CALCULATE(COUNTROWS(Cumplimiento), Cumplimiento[Cumplimiento tarea] = 1, Cumplimiento[departamento] = "Calzado Caballero Lifestyle")
			VAR total_tareas = [Tareas2] / 10
			RETURN IF(DIVIDE(cumplidas, total_tareas, 0) > 0, DIVIDE(cumplidas, total_tareas, 0), 0)
		formatString: 0\ %;-0\ %;0\ %
		lineageTag: a1b2c3d4-e5f6-7890-abcd-ef1234567003

