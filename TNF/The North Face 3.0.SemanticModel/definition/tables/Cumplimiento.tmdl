	measure 'Tarea 11 Almuerzo' =
			
			VAR cumplidas = CALCULATE(COUNTROWS(Cumplimiento), Cumplimiento[Cumplimiento tarea] = 1, Cumplimiento[departamento] = "Almuerzo")
			VAR total_tareas = [Tareas2] / 11
			RETURN IF(DIVIDE(cumplidas, total_tareas, 0) > 0, DIVIDE(cumplidas, total_tareas, 0), 0)
		formatString: 0\ %;-0\ %;0\ %
		lineageTag: a1b2c3d4-e5f6-7890-abcd-ef1234567010

	measure Tareas2 = DISTINCTCOUNT(dim_dates[date]) * 11
		formatString: 0
		lineageTag: a1b2c3d4-e5f6-7890-abcd-ef1234567011

