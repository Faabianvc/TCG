table fct_antes
	lineageTag: d4e7e63e-b7ca-40a2-a8f8-698bb06b503d

	measure 'Total Respuestas' = COUNT(fct_antes[survey_response_id])
		lineageTag: e09986ae-93c7-4ca8-90ec-7675bca77faa

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% Total Conteo' = ```
			
			DIVIDE(
			    COUNT(fct_antes[survey_response_id]), 
			    CALCULATE(
			        COUNT(fct_antes[survey_response_id]), 
			        ALL(fct_antes)
			    ), 
			    0
			)
			```
		formatString: 0%;-0%;0%
		lineageTag: efced14c-92a4-405b-9fa3-d86aef167581

