	column imagen =
			
			CALCULATE(
			    MAX(fct_antes[answer]),
			    FILTER(
			        fct_antes,
			            fct_antes[survey_response_id] = EARLIER(fct_antes[survey_response_id])
			            && fct_antes[question_category] = "Imagen"
			    )
			)
		lineageTag: 226d6056-0a95-4b1f-8ace-c020976e2262
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column descripcion =
			
			CALCULATE(
			    MAX(fct_antes[answer]),
			    FILTER(
			        fct_antes,
			            fct_antes[survey_response_id] = EARLIER(fct_antes[survey_response_id])
			            && fct_antes[question_category] = "Descripcion"
			    )
			)
		lineageTag: 24c0d014-4e01-4c3c-aa0e-2c9fdb3a5aaf
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Usuario = RELATED(dim_usuarios[name])
		lineageTag: 2510860c-e4f4-4b84-870d-7ad5d1d87729
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column tipo_oportunidad =
			
			CALCULATE(
			    MAX(fct_antes[answer]),
			    FILTER(
			        fct_antes,
			            fct_antes[survey_response_id] = EARLIER(fct_antes[survey_response_id])
			            && fct_antes[question_category] = "Tipo-Oportunidad"
			    )
			)
		lineageTag: 808a3d05-343d-4859-805c-b4ab9de3c841
		summarizeBy: none

