		lineageTag: 581e747f-a2bc-48bb-b18a-6deb2d501475
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Periodo = FORMAT(fct_antes[fecha_hora],"yyyy-mm")
		lineageTag: 9c07425f-dd4a-4c93-9464-d560e3228fd7
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Periodo_m =
			
			VAR periodo = fct_antes[Periodo]
			VAR medicion = CONCATENATE("Med 0",fct_antes[medicion])
			RETURN
			medicion
		lineageTag: 5e80d61e-5b48-4182-8e6c-27a3d98ac9a1
		summarizeBy: none

