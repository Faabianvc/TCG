			        font-style: italic;
			      }
			    </style>
			    <div class=""grid-centro""><span class=""fs"">Seleccione una evaluación para ver el comentario...</span></div>"
			
			VAR resultado = COALESCE(comentario_ajustado, sin_comentario)
			
			RETURN
			    IF(is_valid, estilo & "<div>" & resultado & "</div>", mensaje_defecto)
