	measure DiferenciaDias =
			
			VAR FechaMantenimiento = LOOKUPVALUE(Mantenimiento[fecha], Mantenimiento[alerta_id], 'Mantenimiento Status'[ID solicitud])
			VAR FechaStatus        = 'Mantenimiento Status'[fecha]
			RETURN
			    IF(
			        NOT(ISBLANK(FechaMantenimiento)) && NOT(ISBLANK(FechaStatus)),
			        DATEDIFF(FechaMantenimiento, FechaStatus, DAY),
			        BLANK()
			    )
		lineageTag: mt001aaa-0001-4000-a000-000000000003

	measure DiasDesdeMantenimiento =
			
			VAR FechaMantenimiento = Mantenimiento[fecha]
			VAR FechaRespuesta     = LOOKUPVALUE('Mantenimiento Status'[fecha], 'Mantenimiento Status'[ID solicitud], Mantenimiento[alerta_id])
			VAR FechaFinal         = IF(ISBLANK(FechaRespuesta), TODAY(), FechaRespuesta)
			RETURN DATEDIFF(FechaMantenimiento, FechaFinal, DAY)
		lineageTag: mt001aaa-0001-4000-a000-000000000004

