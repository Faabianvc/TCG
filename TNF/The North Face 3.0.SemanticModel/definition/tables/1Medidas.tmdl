	measure Texto_comentario =
			
			VAR comentario_pregunta = CALCULATE(SELECTEDVALUE(fct_comentarios[answer]), fct_comentarios[question_category] <> "Comentario-General")
			VAR comentario_general = CALCULATE(SELECTEDVALUE(fct_comentarios[answer]), fct_comentarios[question_category] = "Comentario-General")
			VAR pregunta = SELECTEDVALUE(fct_respuestas[question_id])
			VAR tipo_encuesta = SELECTEDVALUE(dim_encuestas[quiz_category])
			VAR vacio = "Seleccione un comentario..."
			
			VAR estilo =
			    "<style>
			      div, span {
			        font-family: 'DIN', 'wf_standard-font', sans-serif;
			        font-size: 28px;
			      }
			    </style>"
			
			VAR mensaje_defecto =
			    "<style>
			      .grid-centro {
			        display: grid;
			        place-items: center;
			        height: 140px;
			      }
			      .fs {
			        font-size: 28px;
			        font-family: 'DIN', 'wf_standard-font', sans-serif;
			      }
			    </style>
			    <div class=""grid-centro""><span class=""fs"">Seleccione una evaluación para ver el comentario...</span></div>"
			
			VAR resultado = COALESCE(
			    IF(tipo_encuesta = "Mystery Shopper"
			        ,comentario_general
			        ,IF(ISBLANK(pregunta)
			            ,comentario_general
			            ,comentario_pregunta
			        )
			    )
			    , vacio
			)
			
			RETURN
			    IF(resultado = vacio, BLANK(), estilo & "<div>" & resultado & "</div>")
		lineageTag: 095fda6c-892c-4b9d-ae6c-8f47ec41219a

	measure 'tooltip perfect' = ```
			
			VAR kpi_ = SELECTEDVALUE(fct_respuestas[KPI])
			VAR nota = ROUND([1_ nota ponderada] * 100, 0) & "%"
			var peso_reponderado = ROUND([kpis_peso_reponderado] * 100, 0) & "%"
			var peso_original = ROUND(AVERAGE(dim_kpi[peso]) * 100, 0) & "%"
			
			var repond = IF(peso_original <> peso_reponderado, TRUE(), FALSE())
			var texto = "Puntaje: " & nota & " | Peso: " & peso_reponderado
			    & IF(repond, UNICHAR(10) & "(Peso reponderado, original: " & peso_original & ")", "")
			
			RETURN 
			IF(ISBLANK(kpi_), "-", texto)
			```
		lineageTag: c93495f6-2d73-4577-b405-266fc8f47e84

