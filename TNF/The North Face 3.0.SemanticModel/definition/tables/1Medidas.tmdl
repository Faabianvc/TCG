table 1Medidas
	lineageTag: 9f6d79bb-4138-4e81-bc12-a7f250094933

	measure '1_ nota ponderada' =
			
			VAR KPIsConNotas =
			    ADDCOLUMNS(
			        dim_KPI,
			        "Nota", [1_ sucursal cumplimiento]
			    )
			
			VAR KPIsValidos =
			    FILTER(
			        KPIsConNotas,
			        NOT(ISBLANK([Nota]))
			    )
			
			VAR TotalPesoUsado =
			    SUMX(KPIsValidos, [peso])
			
			VAR SumaPonderada =
			    SUMX(KPIsValidos, [peso] * [Nota])
			
			RETURN
			    IF(
			        TotalPesoUsado > 0,
			        SumaPonderada / TotalPesoUsado,
			        BLANK()
			    )
		formatString: 0%;-0%;0%
		lineageTag: 11aa0077-04c9-4b15-af7c-0565ab6e5e56

	measure '1_ sucursal cumplimiento' = ```
			
			AVERAGEX(
			    SUMMARIZE(
			        fct_respuestas
			        ,fct_respuestas[KPI]
			        ,fct_respuestas[Periodo]
			        ,fct_respuestas[branch_id]
			    ),
			    VAR score = [1_ nota por kpi]
				VAR meta = AVERAGE(dim_Target[Target])
				RETURN
					IF(OR(ISBLANK(score), ISBLANK(meta)), 
						BLANK(),
						IF(meta = 0
							, score
							,IF(score >= meta, 1, 0)
						)
					) 
				)
			```
		lineageTag: 411af7c1-ae43-4b39-9185-e4f1ad336fb3

	measure '1_ nota por kpi' = ```
			
			AVERAGEX(
			    SUMMARIZE(
			        fct_respuestas,
			        dim_dates[periodo],
			        dim_sucursales[id],
			        dim_KPI[KPI],
			        --dimCategoría[Categoría], --Incluir si los KPis se calculan por categoría.
			        --Incluir cualquier otra dimensión que defina el nivel de detalle de los KPIs
			        "promedio", 
			            DIVIDE(
			            SUM(fct_respuestas[obtained_score]),
			            SUM(fct_respuestas[question_total_score])
			        )
			    ),
			    [promedio]
			)
			```
		formatString: 0%;-0%;0%
		lineageTag: 2162af74-363d-4dd6-8e55-6389ca15f88c

