	measure comparacion_periodo =
			
			VAR PeriodoActual = SELECTEDVALUE(fct_respuestas[periodo])
			VAR PeriodoAnterior =
			    FORMAT(
			        EDATE(DATE(LEFT(PeriodoActual, 4), RIGHT(PeriodoActual, 2), 1), -1),
			        "yyyy-MM"
			    )
			
			VAR KPI_ = SELECTEDVALUE(dim_KPI[KPI])
			VAR Clasificacion = SELECTEDVALUE(dim_clasificacion[clasificacion])
			
			VAR NotaActual =
			    ROUND(
			        CALCULATE(
			            [1_ nota ponderada],
			            FILTER(ALL(fct_respuestas),
			                fct_respuestas[periodo] = PeriodoActual
			                && fct_respuestas[KPI] = KPI_
			                && fct_respuestas[clasificacion] = Clasificacion)
			        )
			        , 2
			    )
			
			VAR NotaAnterior =
			    ROUND(
			        CALCULATE(
			            [1_ nota ponderada],
			            FILTER(ALL(fct_respuestas),
			                fct_respuestas[periodo] = PeriodoAnterior
			                && fct_respuestas[KPI] = KPI_
			                && fct_respuestas[clasificacion] = Clasificacion)
			        )
			        , 2
			    )
			
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(NotaActual) || ISBLANK(NotaAnterior), 0, //Sin Flecha
			        NotaActual = NotaAnterior, 1, //Flecha horizontal
			        NotaActual > NotaAnterior, 2, //Flecha hacia arriba
			        NotaActual < NotaAnterior, 3, //Flecha hacia abajo
			        0 //Sin Flecha
			    )
		formatString: 0
		lineageTag: 52168a26-a4ce-4258-9b04-5d051ffe408f

