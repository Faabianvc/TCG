	measure kpis_peso_reponderado = ```
			
			VAR NotaActual = [1_ sucursal cumplimiento]
			
			VAR TotalPesoValido = 
			    CALCULATE(
			        SUM(dim_kpi[peso]),
			        FILTER(
			            ALL(dim_kpi),                    // Quita todos los filtros de dim_kpi
			            NOT ISBLANK([1_ sucursal cumplimiento])
			        ),
			        REMOVEFILTERS( fct_respuestas[category] )   // ← Ignora específicamente el filtro de category
			    )
			
			RETURN
			    IF(
			        NOT ISBLANK(NotaActual),
			        DIVIDE( SELECTEDVALUE(dim_kpi[peso]), TotalPesoValido ),
			        BLANK()
			    )
			```
		lineageTag: ab43f262-b9eb-4888-934b-c2d0d605fbec

