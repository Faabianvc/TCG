	measure tym_cumplimiento =
			
			VAR _tipo = SELECTEDVALUE(fct_asignaciones[period_type])
			VAR _realizadas = [tym_tareas_realizadas]
			VAR _asignadas = [tym_tareas_asignadas]
			RETURN
			    IF(
			        _realizadas = 0,
			        0,
			        SWITCH(
			            _tipo,
			            "weekly", DIVIDE(_realizadas, _asignadas, 0),
			            "monthly", DIVIDE(_realizadas, _asignadas, 0),
			            "daily", DIVIDE(_realizadas, _asignadas, 0),
			            DIVIDE(_realizadas, _asignadas, 0)
			        )
			    )
		formatString: 0%;-0%;0%
		lineageTag: 1a3674e7-72c9-4f17-8ae8-b767ea1af1f9

