		annotation UnderlyingDateTimeDataType = Date

	partition dim_dates = m
		mode: import
		queryGroup: Dims
		source =
				let
				    Origen = Value.NativeQuery(AmazonRedshift.Database("redshift.infra.tcgscout.com","prod"), "SELECT#(lf)    ""date"",#(lf)    periodo,#(lf)    week_day_en,#(lf)    week_day_es,#(lf)    week_day_number,#(lf)    ""day"",#(lf)    ""month"",#(lf)    ""year"",#(lf)    day_of_year,#(lf)    quarter,#(lf)    semester,#(lf)    iso_year,#(lf)    iso_week,#(lf)    iso_week_str,#(lf)    iso_week_year_str,#(lf)    is_last_day_of_month,#(lf)    is_weekend,#(lf)    TO_CHAR(""date"", 'YYYY-MM') || '/w' || CEIL(EXTRACT(DAY FROM ""date"") / 7.0)::INT AS week_of_month#(lf)FROM tcg_l2.vw_calendar c#(lf)WHERE c.""date"" >= (SELECT MIN(a.fecha) FROM northface.vw_answers_v3 a)#(lf)  AND c.""date"" <= (SELECT MAX(a.fecha) FROM northface.vw_answers_v3 a)", null, [EnableFolding=true])
				in
				    Origen

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

