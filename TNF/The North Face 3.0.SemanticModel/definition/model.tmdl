model Model
	culture: es-MX
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: es-CL
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup Fcts

	annotation PBI_QueryGroupOrder = 0

queryGroup Dims

	annotation PBI_QueryGroupOrder = 1

annotation PBI_QueryOrder = ["fct_respuestas","fct_fotos","dim_dates","dim_usuarios","dim_preguntas","dim_target","dim_kpi","dim_sucursales","dim_clasificacion","dim_encuestas","Actualización","1Medidas","fct_comentarios","fct_asignaciones","Marcaje","Cumplimiento","Exhibicion","Gap","Gap_comentarios","Mantenimiento","Mantenimiento Fotos","Mantenimiento Comentarios","Mantenimiento Status"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

ref table fct_respuestas
ref table fct_fotos
ref table dim_dates
ref table dim_usuarios
ref table dim_preguntas
ref table dim_target
ref table dim_kpi
ref table dim_sucursales
ref table dim_clasificacion
ref table dim_encuestas
ref table Actualización
ref table 'Perfect Stores'
ref table 1Medidas
ref table dimMedicion
ref table fct_comentarios
ref table fct_asignaciones
ref table dimFotosUsuario
ref table Marcaje
ref table Cumplimiento
ref table in-out
ref table Calendario_Dim
ref table Exhibicion
ref table Gap
ref table Gap_comentarios
ref table Mantenimiento
ref table 'Mantenimiento Fotos'
ref table 'Mantenimiento Comentarios'
ref table 'Mantenimiento Status'
ref table 'Mantenimiento tiempos'
ref table RespuestasRecientes

ref cultureInfo es-MX

