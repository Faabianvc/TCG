	partition Sucursales = m
		mode: import
		queryGroup: RedShift
		source =
				let
				    Origen = Value.NativeQuery(AmazonRedshift.Database("redshift.infra.tcgscout.com","prod"), "select#(lf)#(tab)b.company_id,#(lf)#(tab)b.id as branch_id,#(lf)#(tab)b.store_id,#(lf)#(tab)case#(lf)#(tab)#(tab)when b.province is null then initcap(b.zone)#(lf)#(tab)#(tab)else b.province#(lf)#(tab)end as ciudad,#(lf)#(tab)initcap(b.chain_name) as cadena,#(lf)#(tab)initcap(b.chain_store) as subcadena,#(lf)#(tab)initcap(b.""name"") as sucursal,#(lf)#(tab)b.latitude ||','||b.longitude as coordenadas#(lf)from tcg_scout_v2.branches b #(lf)where b.company_id = 280#(lf)#(tab)and b.deleted_at is null", null, [EnableFolding=true])
				in
				    Origen

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navegación

