	measure 'precio moda' =
			SWITCH(MAX(FiltroPrecio[ID]),
			1,CALCULATE(MAX(Precios[precio_paquete]),
			    TOPN(1,
			        FILTER(VALUES(Precios[precio_paquete]),
			         NOT(ISBLANK(Precios[precio_paquete]))),[conteo registros])
			),
			2,CALCULATE(MAX(Precios[precio_caja]),
			    TOPN(1,
			        FILTER(VALUES(Precios[precio_caja]),
			         NOT(ISBLANK(Precios[precio_caja]))),[conteo registros])
			))
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: bfac732a-f09f-423a-9042-598825254b5e

	measure 'Precio promedio' =
