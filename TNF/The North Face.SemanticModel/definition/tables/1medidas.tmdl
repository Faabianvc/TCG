	measure tiempo_muerto_text = ```
			
			var minutosEfectivos = IF(ISBLANK(SUM(Marcaje[tiempo_efectivo_tarea])), 0, ROUND(SUM(Marcaje[tiempo_efectivo_tarea]),0))
			var minutosTotales = ROUND(SUM(Marcaje[totalMin]), 0)
			
			var resta = minutosTotales - minutosEfectivos & UNICHAR(10) 
			
