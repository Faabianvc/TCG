	column cargo
		dataType: string
		lineageTag: 2cfcd8a4-2fcd-4e9b-94c9-39abe99fea7b
		summarizeBy: none
		sourceColumn: cargo

		annotation SummarizationSetBy = Automatic

	partition Usuarios_Dim = m
		mode: import
		queryGroup: RedShift
		source =
				let
				    Origen = Value.NativeQuery(AmazonRedshift.Database("redshift.infra.tcgscout.com","prod"), "select distinct#(lf)qr.user_id,#(lf)case#(lf)#(tab)when u.last_name is null then initcap(u.""name"") #(lf)#(tab)else initcap(u.""name"")|| ' ' || initcap(u.last_name)#(lf)end as user_name,#(lf)u.email,#(lf)case #(lf)#(tab)when u.email like '%visual%' then 'Visual'#(lf)#(tab)when u.email like '%promotor%' then 'Promotor'#(lf)end as cargo#(lf)from tcg_scout_v2.quiz_responses qr#(lf)left join tcg_scout_v2.quiz_response_answers qra on qra.quiz_response_id = qr.id#(lf)left join tcg_scout_v2.users u on u.id = qr.user_id #(lf)where qr.quiz_id in (6260,6261,6262,6263,6264,6265,6340,6341,6367,6368,6565,6566,6567,6568,6569,6570) #(lf)and qr.approved is not false#(lf)and qr.deleted_at is null", null, [EnableFolding=true]),
				    #"Duplicados quitados" = Table.Distinct(Origen)
				in
				    #"Duplicados quitados"

	annotation PBI_ResultType = Exception

	annotation PBI_NavigationStepName = Navegación

