	column 'Cumplimiento Check-In' =
			IF(
			            NOT(ISBLANK('in-out'[fecha_entrada])),
			            1,
			            0
			        )
		formatString: 0
		lineageTag: 6976b944-ffac-4d49-b8de-d3a819756bbc
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Cumplimiento Check-Out' =
