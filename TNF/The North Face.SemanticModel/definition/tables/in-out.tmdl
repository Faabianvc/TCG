	partition in-out = m
		mode: import
		queryGroup: RedShift
		source =
				let
				    Origen = Value.NativeQuery(AmazonRedshift.Database("redshift.infra.tcgscout.com","prod"), "select#(lf)cast(qr.branch_id||replace(trunc(CONVERT_TIMEZONE('GMT','GMT+6',qr.started_at)),'-','')||qr.user_id as bigint) as id_,#(lf)qr.branch_id||'|'||trunc(CONVERT_TIMEZONE('GMT','GMT+6',qr.started_at))||'|'||br.id||'|'||qr.user_id as response_id,#(lf)b2.name,#(lf)qr.user_id,#(lf)qr.branch_id,#(lf)min(convert_timezone('America/Guatemala', qr.started_at)) as fecha_entrada,#(lf)sal.fecha_salida#(lf)from tcg_scout_v2.quiz_responses qr#(lf)left join tcg_scout_v2.quiz_response_answers qra on qra.quiz_response_id = qr.id#(lf)left join tcg_scout_v2.questions q on q.id = qra.question_id #(lf)left join tcg_scout_v2.users u on u.id = qr.user_id #(lf)join tcg_scout_v2.branch_quiz bq on bq.id = qr.branch_quiz_id#(lf)join tcg_scout_v2.branches b2 on b2.id = bq.branch_id #(lf)join tcg_scout_v2.brands br on br.id = bq.brand_id#(lf)join tcg_scout_v2.quizzes q2 on q2.id = qr.quiz_id #(lf)left join(#(lf)#(tab)#(tab)#(tab)select distinct#(lf)#(tab)#(tab)#(tab)qr.id,#(lf)#(tab)#(tab)#(tab)qr.branch_id,#(lf)#(tab)#(tab)#(tab)qr.user_id,#(lf)#(tab)#(tab)#(tab)br.id as br_id,#(lf)#(tab)#(tab)#(tab)left(convert_timezone('America/Guatemala', qr.started_at), 10) as fecha_medicion,#(lf)#(tab)#(tab)#(tab)MAX(convert_timezone('America/Guatemala', qr.finished_at)) as fecha_salida#(lf)#(tab)#(tab)#(tab)from tcg_scout_v2.quiz_responses qr #(lf)#(tab)#(tab)#(tab)join tcg_scout_v2.branch_quiz bq on bq.id = qr.branch_quiz_id#(lf)#(tab)#(tab)#(tab)join tcg_scout_v2.brands br on br.id = bq.brand_id#(lf)#(tab)#(tab)#(tab)join tcg_scout_v2.quizzes q2 on q2.id = qr.quiz_id #(lf)#(tab)#(tab)#(tab)where qr.quiz_id in (6263,6262,6566,6568)#(lf)#(tab)#(tab)#(tab)and (qr.approved is null or qr.approved = 1)#(lf)#(tab)#(tab)#(tab)group by qr.user_id, fecha_medicion, qr.branch_id ,br_id, qr.id#(lf)#(tab)) as sal on sal.fecha_medicion = left(convert_timezone('America/Guatemala', qr.started_at),10) and sal.branch_id = qr.branch_id and sal.user_id = qr.user_id and sal.br_id = br.id#(lf)where qr.quiz_id in (6260,6261,6567,6565) #(lf)and qr.approved is not false#(lf)and qr.deleted_at is null#(lf)group by #(lf)id_, response_id, b2.name, qr.user_id, sal.fecha_salida, qr.branch_id", null, [EnableFolding=true]),
				    #"Duplicados quitados" = Table.Distinct(Origen, {"id_"})
				in
				    #"Duplicados quitados"

	annotation PBI_ResultType = Exception

	annotation PBI_NavigationStepName = Navegación

