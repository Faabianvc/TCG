table Cumplimiento
	lineageTag: b2652847-5bd7-4304-9074-2ae4a022b1f0

	measure PorcentajeCumplimiento =
			
			VAR TotalTareas = [Tareas2] * DISTINCTCOUNT(Sucursales[branch_id])
			VAR TareasCumplidas = CALCULATE(COUNTROWS(Cumplimiento), Cumplimiento[Cumplimiento tarea] = 1)
			RETURN CALCULATE(DIVIDE(TareasCumplidas, TotalTareas, 0), Cumplimiento[departamento])
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 93618322-1761-4aa3-a051-78b4f26066b8

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "AveragePerCategory"
				}

		changedProperty = FormatString

	measure 'Tarea 2 Caballeros Lifestyle' =
			
			var cumplidas = CALCULATE(COUNTROWS(Cumplimiento),Cumplimiento[Cumplimiento tarea]=1,Cumplimiento[departamento] = "CABALLEROS LIFESTYLE")
			var total_tareas = [Tareas2]/10
			return IF(DIVIDE(cumplidas, total_tareas,0)>0, DIVIDE(cumplidas, total_tareas,0), 0)
		formatString: 0\ %;-0\ %;0\ %
		lineageTag: fba3533b-ae62-4fae-b04c-61920c98b330

	measure 'Tarea 3 Calzado Caballeros' =
			
			var cumplidas = CALCULATE(COUNTROWS(Cumplimiento),Cumplimiento[Cumplimiento tarea]=1,Cumplimiento[departamento] = "CALZADO CALLEROS LIFESTYLE",Cumplimiento[branch_id])
			var total_tareas = [Tareas2]/10
			return IF(DIVIDE(cumplidas, total_tareas,0)>0, DIVIDE(cumplidas, total_tareas,0), 0)
		formatString: 0\ %;-0\ %;0\ %
		lineageTag: ba211259-bbf9-42b1-aabc-19c0d2a7285c

	measure 'Tarea 4 Damas Lifestyle' =
			
			var cumplidas = CALCULATE(COUNTROWS(Cumplimiento),Cumplimiento[Cumplimiento tarea]=1,Cumplimiento[departamento] = "DAMAS LIFESTYLE",Cumplimiento[branch_id])
			var total_tareas = [Tareas2]/10
			return IF(DIVIDE(cumplidas, total_tareas,0)>0, DIVIDE(cumplidas, total_tareas,0), 0)
		formatString: 0\ %;-0\ %;0\ %
		lineageTag: 7ee430c7-f053-4527-bfa3-b9869005a0e8

	measure 'Tarea 5 Calzado damas' =
			
