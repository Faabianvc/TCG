	partition Cumplimiento = m
		mode: import
		queryGroup: RedShift
		source =
				let
				    Origen = Value.NativeQuery(AmazonRedshift.Database("redshift.infra.tcgscout.com","prod"), "select#(lf)cast(qr.branch_id||replace(trunc(CONVERT_TIMEZONE('GMT','GMT+6',qr.started_at)),'-','')||qr.user_id as bigint) as id_,#(lf)qr.branch_id||'|'||trunc(CONVERT_TIMEZONE('GMT','GMT+6',qr.started_at))||'|'||br.id||'|'||qr.user_id as response_id,#(lf)b2.name,#(lf)q.title as title,#(lf)qr.user_id as User_id,#(lf)br.name as departamento,#(lf)qr.branch_id,#(lf)min( convert_timezone('America/Guatemala', qr.started_at)) as fecha_entrada,#(lf)sal.fecha_salida#(lf)from tcg_scout_v2.quiz_responses qr#(lf)left join tcg_scout_v2.quiz_response_answers qra on qra.quiz_response_id = qr.id#(lf)left join tcg_scout_v2.questions q on q.id = qra.question_id #(lf)left join tcg_scout_v2.users u on u.id = qr.user_id #(lf)join tcg_scout_v2.branch_quiz bq on bq.id = qr.branch_quiz_id#(lf)join tcg_scout_v2.branches b2 on b2.id = bq.branch_id #(lf)join tcg_scout_v2.brands br on br.id = bq.brand_id#(lf)left join(#(lf)#(tab)#(tab)#(tab)select distinct#(lf)#(tab)#(tab)#(tab)qr.id,#(lf)#(tab)#(tab)#(tab)qr.branch_id,#(lf)#(tab)#(tab)#(tab)qr.user_id,#(lf)#(tab)#(tab)#(tab)br.id as br_id,#(lf)#(tab)#(tab)#(tab)left(convert_timezone('America/Guatemala', qr.started_at), 10) as fecha_medicion,#(lf)#(tab)#(tab)#(tab)MAX(convert_timezone('America/Guatemala', qr.finished_at)) as fecha_salida#(lf)#(tab)#(tab)#(tab)from tcg_scout_v2.quiz_responses qr #(lf)#(tab)#(tab)#(tab)join tcg_scout_v2.branch_quiz bq on bq.id = qr.branch_quiz_id#(lf)#(tab)#(tab)#(tab)join tcg_scout_v2.brands br on br.id = bq.brand_id#(lf)#(tab)#(tab)#(tab)where qr.quiz_id in (6265,6368,6263,6262,6341)#(lf)#(tab)#(tab)#(tab)and (qr.approved is null or qr.approved = 1)#(lf)#(tab)#(tab)#(tab)group by qr.user_id, fecha_medicion, qr.branch_id ,br_id, qr.id#(lf)#(tab)) as sal on sal.fecha_medicion = left(convert_timezone('America/Guatemala', qr.started_at),10) and sal.branch_id = qr.branch_id and sal.user_id = qr.user_id and sal.br_id = br.id#(lf)where qr.quiz_id in (6264,6367,6261,6260,6340) #(lf)and qr.approved is not false#(lf)and qr.deleted_at is null#(lf)and ((title like '%Indica la cantidad de fotos que necesitas tomar de como encontraste%') or (title like'%Captura una foto de la fachada del PDV tipo selfie%') or(title like '%Has realizado el marcaje de salida%'))#(lf)group by #(lf)id_, response_id, b2.name, title, qr.user_id, departamento,sal.fecha_salida, qr.branch_id", null, [EnableFolding=true]),
				    #"Fecha insertada" = Table.AddColumn(Origen, "Fecha", each DateTime.Date([fecha_entrada]), type date),
				    #"Columnas quitadas1" = Table.RemoveColumns(#"Fecha insertada",{"title"}),
				    #"Duplicados quitados" = Table.Distinct(#"Columnas quitadas1", {"fecha_entrada"})
				in
				    #"Duplicados quitados"

	annotation PBI_ResultType = Exception

	annotation PBI_NavigationStepName = Navegación

