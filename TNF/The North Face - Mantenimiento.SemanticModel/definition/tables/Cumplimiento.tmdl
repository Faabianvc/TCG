	measure 'Tarea 7 Calzado deportivo' =
			
			var cumplidas = CALCULATE(COUNTROWS(Cumplimiento),Cumplimiento[Cumplimiento tarea]=1,Cumplimiento[departamento] ="CALZADO DEPORTIVO",Cumplimiento[branch_id])
			var total_tareas = [Tareas2]/10
			return IF(DIVIDE(cumplidas, total_tareas,0)>0, DIVIDE(cumplidas, total_tareas,0), 0)
		formatString: 0\ %;-0\ %;0\ %
		lineageTag: 494528fd-c7e5-4299-ac53-2ef641135d3a

	measure 'Tarea 8 Kids' =
			var cumplidas = CALCULATE(COUNTROWS(Cumplimiento),Cumplimiento[Cumplimiento tarea]=1,Cumplimiento[departamento] ="KIDS",Cumplimiento[branch_id])
			var total_tareas = [Tareas2]/10
			return IF(DIVIDE(cumplidas, total_tareas,0)>0, DIVIDE(cumplidas, total_tareas,0), 0)
		formatString: 0\ %;-0\ %;0\ %
		lineageTag: d9e6d606-301d-49de-9a08-f403b1c7f46f

	measure Tareas2 = DISTINCTCOUNT(Calendario_Dim[fecha]) * 11
		formatString: 0
		lineageTag: 1022e09d-f97e-46cd-955d-2dd0c69d6cf3

	measure 'Tarea 9 Accesorios deportivos' =
			
			var cumplidas = CALCULATE(COUNTROWS(Cumplimiento),Cumplimiento[Cumplimiento tarea]=1,Cumplimiento[departamento] ="ACCESORIOS DEPORTIVOS",Cumplimiento[branch_id])
			var total_tareas = [Tareas2]/10
			return IF(DIVIDE(cumplidas, total_tareas,0)>0, DIVIDE(cumplidas, total_tareas,0), 0)
		formatString: 0\ %;-0\ %;0\ %
		lineageTag: f7cdbbf1-d91e-4b21-953b-559f6972cbf9

	measure 'Tarea 11 Almuerzo' =
			var cumplidas = CALCULATE(COUNTROWS(Cumplimiento),Cumplimiento[Cumplimiento tarea]=1,Cumplimiento[departamento] ="Almuerzo",Cumplimiento[branch_id])
			var total_tareas = [Tareas2]/11
			return IF(DIVIDE(cumplidas, total_tareas,0)>0, DIVIDE(cumplidas, total_tareas,0), 0)
		formatString: 0\ %;-0\ %;0\ %
		lineageTag: 30aa3225-5eca-4226-b873-e25f790c066f

