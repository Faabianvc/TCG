			var total_tareas = [Tareas2]/10
			return IF(DIVIDE(cumplidas, total_tareas,0)>0, DIVIDE(cumplidas, total_tareas,0), 0)
		formatString: 0\ %;-0\ %;0\ %
		lineageTag: 334f2cbb-f079-4716-a3a9-3211a4123258

	measure 'Tarea 6 Ropa deportiva' =
			
			var cumplidas = CALCULATE(COUNTROWS(Cumplimiento),Cumplimiento[Cumplimiento tarea]=1,Cumplimiento[departamento] ="ROPA DEPORTIVA",Cumplimiento[branch_id])
