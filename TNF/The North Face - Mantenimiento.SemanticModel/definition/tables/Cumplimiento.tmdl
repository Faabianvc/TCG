	column 'Cumplimiento tarea' =
			IF(
			            NOT(ISBLANK('Cumplimiento'[fecha_entrada])) && NOT(ISBLANK('Cumplimiento'[fecha_salida])) && 'Cumplimiento'[fecha_entrada] <> 0 && 'Cumplimiento'[fecha_salida] <> 0,
			            1,
			            0
			        )
		lineageTag: 496fd61a-6200-45ac-8cab-43a1c765cb10
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

