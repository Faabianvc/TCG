table Marcaje
	lineageTag: e2a523e0-4cc2-4532-943f-807f05b6395a

	measure Tareas = ```
			
			 var tareas = CALCULATE(COUNTROWS(Cumplimiento), Cumplimiento[Cumplimiento tarea]=1, Cumplimiento[branch_id])
			 var cin = CALCULATE(COUNTROWS('in-out'), 'in-out'[Cumplimiento Check-In]=1, 'in-out'[branch_id])
			 var cout = CALCULATE(COUNTROWS('in-out'), 'in-out'[Cumplimiento Check-Out]=1, 'in-out'[branch_id])
			 RETURN IF(tareas + cin + cout > 0, tareas + cin + cout, 0)
			```
		formatString: 0
		lineageTag: d11c1719-b9bf-4f3b-9130-251637926227

