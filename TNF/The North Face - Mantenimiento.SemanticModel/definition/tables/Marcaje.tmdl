	column DiferenciaHoras = ```
			
			    VAR DiferenciaTotalHoras = IF(ISBLANK(Marcaje[salida]), BLANK(), ABS(DATEDIFF('Marcaje'[entrada], 'Marcaje'[salida], SECOND)) / 3600)
			    VAR Horas = INT(DiferenciaTotalHoras)
			    VAR Minutos = INT(MOD(DiferenciaTotalHoras * 60, 60))
			    VAR Segundos = INT(MOD(DiferenciaTotalHoras * 3600, 60))
			    RETURN IF(ISBLANK(Marcaje[salida]), BLANK(), FORMAT(Horas, "00") & ":" & FORMAT(Minutos, "00") & ":" & FORMAT(Segundos, "00"))
			```
		lineageTag: 1d0c5648-e42e-4358-abb6-8b3e5b54a2d5
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

