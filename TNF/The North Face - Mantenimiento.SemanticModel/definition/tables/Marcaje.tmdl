	column tiempo_efectivo_tarea =
			
			var damaLife_minutos = ABS(DATEDIFF(Marcaje[dama_lifestyle_entrada], Marcaje[dama_lifestyle_salida],  MINUTE))
			var ropaDepor_minutos = ABS(DATEDIFF(Marcaje[ropa_depor_entrada], Marcaje[ropa_depor_salida],  MINUTE))
			var calzadoDama_minutos = ABS(DATEDIFF(Marcaje[calzado_dama_entrada], Marcaje[calzado_dama_salida],  MINUTE))
			var accesoDepor_minutos = ABS(DATEDIFF(Marcaje[accesorio_depor_entrada], Marcaje[accesorio_depor_salida],  MINUTE))
			var calzadoCab_minutos = ABS(DATEDIFF(Marcaje[calzado_caballero_entrada], Marcaje[calzado_caballero_salida],  MINUTE))
			var cabLife_minutos = ABS(DATEDIFF(Marcaje[caballero_lifestyle_entrada], Marcaje[caballero_lifestyle_salida],  MINUTE))
			var kids_minutos = ABS(DATEDIFF(Marcaje[kids_entrada], Marcaje[kids_salida],  MINUTE))
			
			return damaLife_minutos + ropaDepor_minutos + calzadoDama_minutos + accesoDepor_minutos + calzadoCab_minutos + cabLife_minutos + kids_minutos
		formatString: 0
		lineageTag: 36a72925-2020-4e87-825c-b660d6f1cd50
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Cargo = ```
			
			    IF(
			        CONTAINSSTRING('Marcaje'[email], "promotor"), 
			        "Promotor",
			        IF(
			            CONTAINSSTRING('Marcaje'[email], "visual"),
			            "Visual",
			            BLANK()
			        )
			    )
			```
		lineageTag: 91e5f942-1aec-40b6-9fd9-ecefe326f0c5
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Conteo tareas' = ```
			
			    VAR tarea_1 =
			        IF(
			            NOT(ISBLANK('Marcaje'[calzado_depor_entrada])) && NOT(ISBLANK('Marcaje'[calzado_depor_salida])) && 'Marcaje'[calzado_depor_entrada] <> 0 && 'Marcaje'[calzado_depor_salida] <> 0,
			            1,
			            0
			        )
			    VAR tarea_2 =  IF(
			            NOT(ISBLANK('Marcaje'[ropa_depor_entrada])) && NOT(ISBLANK('Marcaje'[ropa_depor_salida])) && 'Marcaje'[ropa_depor_entrada] <> 0 && 'Marcaje'[ropa_depor_salida] <> 0,
			            1,
			            0
			        )
			    VAR tarea_3 =  IF(
			            NOT(ISBLANK('Marcaje'[accesorio_depor_entrada])) && NOT(ISBLANK('Marcaje'[accesorio_depor_salida])) && 'Marcaje'[accesorio_depor_entrada] <> 0 && 'Marcaje'[accesorio_depor_salida] <> 0,
			            1,
			            0
			        )
			    VAR tarea_4 =  IF(
			            NOT(ISBLANK('Marcaje'[calzado_dama_entrada])) && NOT(ISBLANK('Marcaje'[calzado_dama_salida])) && 'Marcaje'[calzado_dama_entrada] <> 0 && 'Marcaje'[calzado_dama_salida] <> 0,
			            1,
			            0
			        )
			    VAR tarea_5 =  IF(
			            NOT(ISBLANK('Marcaje'[calzado_caballero_entrada])) && NOT(ISBLANK('Marcaje'[calzado_caballero_salida])) && 'Marcaje'[calzado_caballero_entrada] <> 0 && 'Marcaje'[calzado_caballero_salida] <> 0,
			            1,
			            0
			        )
			    VAR tarea_6 =  IF(
			            NOT(ISBLANK('Marcaje'[dama_lifestyle_entrada])) && NOT(ISBLANK('Marcaje'[dama_lifestyle_salida])) && 'Marcaje'[dama_lifestyle_entrada] <> 0 && 'Marcaje'[dama_lifestyle_salida] <> 0,
			            1,
			            0
			        )
			    VAR tarea_7 =  IF(
			            NOT(ISBLANK('Marcaje'[caballero_lifestyle_entrada])) && NOT(ISBLANK('Marcaje'[caballero_lifestyle_salida])) && 'Marcaje'[caballero_lifestyle_entrada] <> 0 && 'Marcaje'[caballero_lifestyle_salida] <> 0,
			            1,
			            0
			        )
			    VAR tarea_8 =  IF(
			            NOT(ISBLANK('Marcaje'[kids_entrada])) && NOT(ISBLANK('Marcaje'[kids_salida])) && 'Marcaje'[kids_entrada] <> 0 && 'Marcaje'[kids_salida] <> 0,
			            1,
			            0
			        )
			    RETURN
			        tarea_1 + tarea_2 + tarea_3 + tarea_4 + tarea_5 + tarea_6 + tarea_7 + tarea_8
			```
		formatString: 0
		lineageTag: 0bb1c76a-25c7-4f67-a47a-b85082f11096
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

