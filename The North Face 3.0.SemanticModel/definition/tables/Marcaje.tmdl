	column totalmin
		dataType: int64
		formatString: 0
		lineageTag: c97b7036-2f0c-4e97-8c57-80aeecec21de
		summarizeBy: sum
		sourceColumn: totalmin

		annotation SummarizationSetBy = Automatic

	column Usuario = RELATED(dim_usuarios[name])
		lineageTag: 25434c53-f753-470c-b7fc-1abbd4e37628
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition Marcaje = m
		mode: import
		queryGroup: Fcts
		source =
				let
				    Origen = Value.NativeQuery(
				        AmazonRedshift.Database("redshift.infra.tcgscout.com", "prod"),
				        "
				SELECT
				    cin.survey_response_id,
				    cin.branch_id,
				    cin.user_id,
				    LEFT(CAST(cin.response_started_at AS VARCHAR), 7)  AS añomes,
				    CAST(cin.response_started_at AS DATE)              AS fecha,
				    cin.response_started_at                            AS entrada,
				    cout.response_finished_at                          AS salida,
				    DATEDIFF('minute', cin.response_started_at,
				             cout.response_finished_at)                AS totalMin,
				
				    cin.answer                                         AS firma,
				    cout.answer                                        AS foto_salida,
				
				    al_in.response_started_at                          AS almuerzo_entrada,
				    al_in.answer                                       AS foto_al_entrada,
				    al_out.response_finished_at                        AS almuerzo_salida,
				    al_out.answer                                      AS foto_al_salida,
				
				    ropa.response_started_at                           AS ropa_depor_entrada,
				    ropa.response_finished_at                          AS ropa_depor_salida,
				
				    calzado_dep.response_started_at                    AS calzado_depor_entrada,
				    calzado_dep.response_finished_at                   AS calzado_depor_salida,
				
				    accesorios.response_started_at                     AS accesorio_depor_entrada,
				    accesorios.response_finished_at                    AS accesorio_depor_salida,
				
				    calzado_dam.response_started_at                    AS calzado_dama_entrada,
				    calzado_dam.response_finished_at                   AS calzado_dama_salida,
				
				    calzado_cab.response_started_at                    AS calzado_caballero_entrada,
				    calzado_cab.response_finished_at                   AS calzado_caballero_salida,
				
				    damas_life.response_started_at                     AS dama_lifestyle_entrada,
				    damas_life.response_finished_at                    AS dama_lifestyle_salida,
				
				    cab_life.response_started_at                       AS caballero_lifestyle_entrada,
				    cab_life.response_finished_at                      AS caballero_lifestyle_salida,
				
				    kids.response_started_at                           AS kids_entrada,
				    kids.response_finished_at                          AS kids_salida
				
				FROM (
				    SELECT survey_response_id, branch_id, user_id,
				           MIN(response_started_at)                               AS response_started_at,
				           MAX(CASE WHEN question_type = 'image' THEN answer END) AS answer
				    FROM tcg_l1_v3.answers
				    WHERE survey_id = 1610
				      AND response_is_approved = 1
				      AND answer_is_deleted = false
				    GROUP BY survey_response_id, branch_id, user_id
				) cin
				
				LEFT JOIN (
				    SELECT branch_id, user_id,
				           CAST(response_started_at AS DATE)                      AS fecha,
				           MAX(response_finished_at)                              AS response_finished_at,
				           MAX(CASE WHEN question_type = 'image' THEN answer END) AS answer
				    FROM tcg_l1_v3.answers
				    WHERE survey_id = 1611
				      AND response_is_approved = 1
				      AND answer_is_deleted = false
				    GROUP BY branch_id, user_id, CAST(response_started_at AS DATE)
				) cout
				    ON cout.branch_id = cin.branch_id
				   AND cout.user_id   = cin.user_id
				   AND cout.fecha     = CAST(cin.response_started_at AS DATE)
				
				LEFT JOIN (
				    SELECT branch_id, user_id,
				           CAST(response_started_at AS DATE)                      AS fecha,
				           MIN(response_started_at)                               AS response_started_at,
				           MAX(CASE WHEN question_type = 'image' THEN answer END) AS answer
				    FROM tcg_l1_v3.answers
				    WHERE survey_id = 1612
				      AND response_is_approved = 1
				      AND answer_is_deleted = false
				    GROUP BY branch_id, user_id, CAST(response_started_at AS DATE)
				) al_in
				    ON al_in.branch_id = cin.branch_id
				   AND al_in.user_id   = cin.user_id
				   AND al_in.fecha     = CAST(cin.response_started_at AS DATE)
				
				LEFT JOIN (
				    SELECT branch_id, user_id,
				           CAST(response_started_at AS DATE)                      AS fecha,
				           MAX(response_finished_at)                              AS response_finished_at,
				           MAX(CASE WHEN question_type = 'image' THEN answer END) AS answer
				    FROM tcg_l1_v3.answers
				    WHERE survey_id = 1613
				      AND response_is_approved = 1
				      AND answer_is_deleted = false
				    GROUP BY branch_id, user_id, CAST(response_started_at AS DATE)
				) al_out
				    ON al_out.branch_id = cin.branch_id
				   AND al_out.user_id   = cin.user_id
				   AND al_out.fecha     = CAST(cin.response_started_at AS DATE)
				
				LEFT JOIN (
				    SELECT branch_id, user_id,
				           CAST(response_started_at AS DATE) AS fecha,
				           MIN(response_started_at)          AS response_started_at,
				           MAX(response_finished_at)         AS response_finished_at
				    FROM tcg_l1_v3.answers
				    WHERE task_category_name = 'Ropa Deportiva'
				      AND response_is_approved = 1
				    GROUP BY branch_id, user_id, CAST(response_started_at AS DATE)
				) ropa
				    ON ropa.branch_id = cin.branch_id
				   AND ropa.user_id   = cin.user_id
				   AND ropa.fecha     = CAST(cin.response_started_at AS DATE)
				
				LEFT JOIN (
				    SELECT branch_id, user_id,
				           CAST(response_started_at AS DATE) AS fecha,
				           MIN(response_started_at)          AS response_started_at,
				           MAX(response_finished_at)         AS response_finished_at
				    FROM tcg_l1_v3.answers
				    WHERE task_category_name = 'Calzado Deportivo'
				      AND response_is_approved = 1
				    GROUP BY branch_id, user_id, CAST(response_started_at AS DATE)
				) calzado_dep
				    ON calzado_dep.branch_id = cin.branch_id
				   AND calzado_dep.user_id   = cin.user_id
				   AND calzado_dep.fecha     = CAST(cin.response_started_at AS DATE)
				
				LEFT JOIN (
				    SELECT branch_id, user_id,
				           CAST(response_started_at AS DATE) AS fecha,
				           MIN(response_started_at)          AS response_started_at,
				           MAX(response_finished_at)         AS response_finished_at
				    FROM tcg_l1_v3.answers
				    WHERE task_category_name = 'Accesorios Deportivos'
				      AND response_is_approved = 1
				    GROUP BY branch_id, user_id, CAST(response_started_at AS DATE)
				) accesorios
				    ON accesorios.branch_id = cin.branch_id
				   AND accesorios.user_id   = cin.user_id
				   AND accesorios.fecha     = CAST(cin.response_started_at AS DATE)
				
				LEFT JOIN (
				    SELECT branch_id, user_id,
				           CAST(response_started_at AS DATE) AS fecha,
				           MIN(response_started_at)          AS response_started_at,
				           MAX(response_finished_at)         AS response_finished_at
				    FROM tcg_l1_v3.answers
				    WHERE task_category_name = 'Calzado Damas Lifestyle'
				      AND response_is_approved = 1
				    GROUP BY branch_id, user_id, CAST(response_started_at AS DATE)
				) calzado_dam
				    ON calzado_dam.branch_id = cin.branch_id
				   AND calzado_dam.user_id   = cin.user_id
				   AND calzado_dam.fecha     = CAST(cin.response_started_at AS DATE)
				
				LEFT JOIN (
				    SELECT branch_id, user_id,
				           CAST(response_started_at AS DATE) AS fecha,
				           MIN(response_started_at)          AS response_started_at,
				           MAX(response_finished_at)         AS response_finished_at
				    FROM tcg_l1_v3.answers
				    WHERE task_category_name = 'Calzado Caballero Lifestyle'
				      AND response_is_approved = 1
				    GROUP BY branch_id, user_id, CAST(response_started_at AS DATE)
				) calzado_cab
				    ON calzado_cab.branch_id = cin.branch_id
				   AND calzado_cab.user_id   = cin.user_id
				   AND calzado_cab.fecha     = CAST(cin.response_started_at AS DATE)
				
				LEFT JOIN (
				    SELECT branch_id, user_id,
				           CAST(response_started_at AS DATE) AS fecha,
				           MIN(response_started_at)          AS response_started_at,
				           MAX(response_finished_at)         AS response_finished_at
				    FROM tcg_l1_v3.answers
				    WHERE task_category_name = 'Damas Lifestyle'
				      AND response_is_approved = 1
				    GROUP BY branch_id, user_id, CAST(response_started_at AS DATE)
				) damas_life
				    ON damas_life.branch_id = cin.branch_id
				   AND damas_life.user_id   = cin.user_id
				   AND damas_life.fecha     = CAST(cin.response_started_at AS DATE)
				
				LEFT JOIN (
				    SELECT branch_id, user_id,
				           CAST(response_started_at AS DATE) AS fecha,
				           MIN(response_started_at)          AS response_started_at,
				           MAX(response_finished_at)         AS response_finished_at
				    FROM tcg_l1_v3.answers
				    WHERE task_category_name = 'Caballero Lifestyle'
				      AND response_is_approved = 1
				    GROUP BY branch_id, user_id, CAST(response_started_at AS DATE)
				) cab_life
				    ON cab_life.branch_id = cin.branch_id
				   AND cab_life.user_id   = cin.user_id
				   AND cab_life.fecha     = CAST(cin.response_started_at AS DATE)
				
				LEFT JOIN (
				    SELECT branch_id, user_id,
				           CAST(response_started_at AS DATE) AS fecha,
				           MIN(response_started_at)          AS response_started_at,
				           MAX(response_finished_at)         AS response_finished_at
				    FROM tcg_l1_v3.answers
				    WHERE task_category_name = 'Kids'
				      AND response_is_approved = 1
				    GROUP BY branch_id, user_id, CAST(response_started_at AS DATE)
				) kids
				    ON kids.branch_id = cin.branch_id
				   AND kids.user_id   = cin.user_id
				   AND kids.fecha     = CAST(cin.response_started_at AS DATE)
				        ",
				        null,
				        [EnableFolding = false]
				    ),
				    #"Tipo cambiado" = Table.TransformColumnTypes(Origen, {
				        {"fecha",                       type date},
				        {"entrada",                     type datetime},
				        {"salida",                      type datetime},
				        {"firma",                       type text},
