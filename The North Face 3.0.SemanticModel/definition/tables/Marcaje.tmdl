		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isDateTimeCustom":true}

	column tiempo_efectivo_tarea =
			VAR ropa_min        = ABS(DATEDIFF(Marcaje[ropa_depor_entrada],        Marcaje[ropa_depor_salida],        MINUTE))
			VAR calzado_dep_min = ABS(DATEDIFF(Marcaje[calzado_depor_entrada],     Marcaje[calzado_depor_salida],     MINUTE))
			VAR accesorio_min   = ABS(DATEDIFF(Marcaje[accesorio_depor_entrada],   Marcaje[accesorio_depor_salida],   MINUTE))
			VAR calzado_dam_min = ABS(DATEDIFF(Marcaje[calzado_dama_entrada],      Marcaje[calzado_dama_salida],      MINUTE))
			VAR calzado_cab_min = ABS(DATEDIFF(Marcaje[calzado_caballero_entrada], Marcaje[calzado_caballero_salida], MINUTE))
			VAR dama_min        = ABS(DATEDIFF(Marcaje[dama_lifestyle_entrada],    Marcaje[dama_lifestyle_salida],    MINUTE))
			VAR cab_min         = ABS(DATEDIFF(Marcaje[caballero_lifestyle_entrada], Marcaje[caballero_lifestyle_salida], MINUTE))
			VAR kids_min        = ABS(DATEDIFF(Marcaje[kids_entrada],              Marcaje[kids_salida],              MINUTE))
			RETURN ropa_min + calzado_dep_min + accesorio_min + calzado_dam_min + calzado_cab_min + dama_min + cab_min + kids_min
		formatString: 0
		lineageTag: b5c6d7e8-f9a0-1234-bcde-456789012345
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Conteo_tareas =
			VAR t1 = IF(NOT(ISBLANK(Marcaje[ropa_depor_entrada]))        && NOT(ISBLANK(Marcaje[ropa_depor_salida])),        1, 0)
			VAR t2 = IF(NOT(ISBLANK(Marcaje[calzado_depor_entrada]))     && NOT(ISBLANK(Marcaje[calzado_depor_salida])),     1, 0)
			VAR t3 = IF(NOT(ISBLANK(Marcaje[accesorio_depor_entrada]))   && NOT(ISBLANK(Marcaje[accesorio_depor_salida])),   1, 0)
			VAR t4 = IF(NOT(ISBLANK(Marcaje[calzado_dama_entrada]))      && NOT(ISBLANK(Marcaje[calzado_dama_salida])),      1, 0)
			VAR t5 = IF(NOT(ISBLANK(Marcaje[calzado_caballero_entrada])) && NOT(ISBLANK(Marcaje[calzado_caballero_salida])), 1, 0)
			VAR t6 = IF(NOT(ISBLANK(Marcaje[dama_lifestyle_entrada]))    && NOT(ISBLANK(Marcaje[dama_lifestyle_salida])),    1, 0)
			VAR t7 = IF(NOT(ISBLANK(Marcaje[caballero_lifestyle_entrada])) && NOT(ISBLANK(Marcaje[caballero_lifestyle_salida])), 1, 0)
			VAR t8 = IF(NOT(ISBLANK(Marcaje[kids_entrada]))              && NOT(ISBLANK(Marcaje[kids_salida])),              1, 0)
			RETURN t1 + t2 + t3 + t4 + t5 + t6 + t7 + t8
		formatString: 0
		lineageTag: c6d7e8f9-a0b1-2345-cdef-567890123456
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column DiferenciaHoras =
			VAR diff_seg  = IF(ISBLANK(Marcaje[salida]), BLANK(), ABS(DATEDIFF(Marcaje[entrada], Marcaje[salida], SECOND)) / 3600)
			VAR horas     = INT(diff_seg)
			VAR minutos   = INT(MOD(diff_seg * 60, 60))
			VAR segundos  = INT(MOD(diff_seg * 3600, 60))
			RETURN IF(ISBLANK(Marcaje[salida]), BLANK(), FORMAT(horas, "00") & ":" & FORMAT(minutos, "00") & ":" & FORMAT(segundos, "00"))
		lineageTag: d7e8f9a0-b1c2-3456-defa-678901234567
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

