	partition fct_pbi_comments = m
		mode: import
		queryGroup: Fcts
		source =
				let
				    Origen = Value.NativeQuery(AmazonRedshift.Database("redshift.infra.tcgscout.com","prod"), "SELECT comment_id, user_id, ""name"", powerbi_report_id, updated_at, ""comment"", page, semana, sucursal, question, kpi, tipo_aud #(lf),deadline, medicion#(lf)FROM northface.vw_pbi_comments", null, [EnableFolding=true])
