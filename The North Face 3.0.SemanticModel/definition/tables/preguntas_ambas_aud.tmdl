	partition preguntas_ambas_aud = calculated
		mode: import
		source =
				
				/*SUMMARIZE(
				    ADDCOLUMNS(
				        SUMMARIZE(
				            FILTER(
				                fct_respuestas,
				                NOT ISBLANK(fct_respuestas[short_question])
				                    && fct_respuestas[short_question] <> "" && fct_respuestas[has_score] = 1
				            ),
				            fct_respuestas[short_question]
				        ),
				        "esta_en_ambas_aud",
				            VAR Tiene1014 =
				                CALCULATE(
				                    COUNTROWS(fct_respuestas),
				                    fct_respuestas[quiz_id] = 1014
				                )
				            VAR Tiene1019 =
				                CALCULATE(
				                    COUNTROWS(fct_respuestas),
				                    fct_respuestas[quiz_id] = 1019
				                )
				            RETURN
				                IF(
				                    Tiene1014 > 0 && Tiene1019 > 0,
				                    "Sí",
				                    "No"
				                )
				    ),
				    [short_question],
				    [esta_en_ambas_aud]
				)*/
				"Si"

	annotation PBI_Id = f2d3e7e1283d476796a6e64cf240de9e

