	column comentario_general =
			
			CALCULATE(
			    MAX(fct_respuestas[answer]),
			    FILTER(
			        fct_respuestas,
			        fct_respuestas[survey_response_id] = EARLIER(fct_respuestas[survey_response_id])
			            && fct_respuestas[question_category] = "Comentario-General"
			    )
			)
		lineageTag: 77c837ea-e78b-44a5-bbe7-f01b4e21fc52
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Periodo_m =
			
			VAR periodo = fct_respuestas[Periodo]
			VAR medicion = CONCATENATE("Med 0",fct_respuestas[medicion])
			RETURN
			medicion
		lineageTag: 2d72c4ca-c01f-4c0f-8c7a-99ad1618d3ec
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

