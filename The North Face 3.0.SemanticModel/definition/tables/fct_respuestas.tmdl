		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column key_cta = [page_pbi_comments] & "|" & [periodo_pbi_comments] & "|" & [Sucursal] & "|" & [short_question]  & "|" & [Kpi] & "|" & [medicion] & "|" & [quiz_type_pbi_comments]    /*question_short - periodo - name - medicion*/
		lineageTag: 2b01837d-539a-4374-bec9-3ece076a91e1
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column page_pbi_comments =
			
			SWITCH(
			    [quiz_category],
			    "Auditoría", "Detalle AUD",
			    "Mystery Shopper", "Detalle MS",
			    BLANK()
			)
		lineageTag: b6bbe3f8-5710-4178-99f3-74288ae6579c
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column periodo_pbi_comments = RELATED(dim_dates[periodo])
		lineageTag: 3b238063-79bf-43ea-b749-86c8a71716cc
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column tiene_cta =
			
			IF(
			    COUNTROWS(RELATEDTABLE(fct_pbi_comments)) > 0,
			    "Ver sólo comentarios CTA",
			    "No"
			)
		lineageTag: 9075ba2b-4159-4ae7-9884-b56e6ebdcd73
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column quiz_type_pbi_comments =
			
			SWITCH(
			    RELATED(dim_encuestas[quiz_type]),"Mystery Shopper", "Detalle MS", RELATED(dim_encuestas[quiz_type])
			)
		lineageTag: dac70ea6-1ae4-4832-a121-cd2551e1d24f
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition fct_respuestas = m
		mode: import
		queryGroup: Fcts
		source =
				let
				    Origen = Value.NativeQuery(AmazonRedshift.Database("redshift.infra.tcgscout.com","prod"), "SELECT a.survey_response_id, fecha_hora, fecha_hora_fin, fecha, question_id, depends_on_question_id, photo_question_id, quiz_id, user_id#(lf)#(tab), branch_id, answer, answer_integer, product_id, has_score, obtained_score, question_total_score, category#(lf)#(tab), sub_category, modulo, question_response_id, comment_teleaudit, response_is_approved#(lf)#(tab), app, kpi_id, is_image, is_video, is_audio, is_comment, orden_foto_question, question_category, quiz_category, m.medicion,ad.survey_response_despues#(lf),ad.survey_response_review#(lf)FROM northface.vw_answers_v3 a#(lf)LEFT JOIN northface.vw_mediciones m ON a.survey_response_id = m.survey_response_id#(lf)LEFT JOIN northface.vw_responses_antes_despues ad#(lf)ON a.survey_response_id = ad.survey_response_antes", null, [EnableFolding=true]),
				    #"Tipo cambiado" = Table.TransformColumnTypes(Origen,{{"fecha", type date}})
				in
				    #"Tipo cambiado"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

