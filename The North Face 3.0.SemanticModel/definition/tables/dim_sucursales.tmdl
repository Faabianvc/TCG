		summarizeBy: none
		sourceColumn: portrait_image

		annotation SummarizationSetBy = Automatic

	column sucursal =
			
			VAR Texto = dim_sucursales[name]
			VAR Largo = LEN(Texto)
			
			----------------------------------
			-- CONFIGURACIÓN
			----------------------------------
			
			VAR Limite2Lineas = 8
			VAR Limite3Lineas = 14
			
			----------------------------------
			-- ESPACIOS
			----------------------------------
			
			VAR E1 = SEARCH(" ", Texto, 1, 0)
			VAR E2 = SEARCH(" ", Texto, E1 + 1, 0)
			VAR E3 = SEARCH(" ", Texto, E2 + 1, 0)
			VAR E4 = SEARCH(" ", Texto, E3 + 1, 0)
			
			----------------------------------
			-- CASO 2 LINEAS
			----------------------------------
			
			VAR Centro = Largo / 2
			
			VAR D1 = IF(E1 > 0, ABS(E1 - Centro), 999)
			VAR D2 = IF(E2 > 0, ABS(E2 - Centro), 999)
			VAR D3 = IF(E3 > 0, ABS(E3 - Centro), 999)
			VAR D4 = IF(E4 > 0, ABS(E4 - Centro), 999)
			
			VAR Salto2 =
			    SWITCH(
			        TRUE(),
			        D1 <= D2 && D1 <= D3 && D1 <= D4, E1,
			        D2 <= D3 && D2 <= D4, E2,
			        D3 <= D4, E3,
			        E4
			    )
			
			VAR Resultado2 =
			    IF(
			        Salto2 > 0,
			        REPLACE(Texto, Salto2, 1, UNICHAR(10)),
			        Texto
			    )
			
			----------------------------------
			-- COMBINACION E1-E2
			----------------------------------
			
			VAR M12 =
			    IF(
			        E1 > 0 && E2 > 0,
			        MAX(
			            E1 - 1,
			            MAX(
			                E2 - E1 - 1,
			                Largo - E2
			            )
			        ),
			        999
			    )
			
			----------------------------------
			-- COMBINACION E1-E3
			----------------------------------
			
			VAR M13 =
			    IF(
			        E1 > 0 && E3 > 0,
			        MAX(
			            E1 - 1,
			            MAX(
			                E3 - E1 - 1,
			                Largo - E3
			            )
			        ),
			        999
			    )
			
			----------------------------------
			-- COMBINACION E1-E4
			----------------------------------
			
			VAR M14 =
			    IF(
			        E1 > 0 && E4 > 0,
			        MAX(
			            E1 - 1,
			            MAX(
			                E4 - E1 - 1,
			                Largo - E4
			            )
			        ),
			        999
			    )
			
			----------------------------------
			-- COMBINACION E2-E3
			----------------------------------
			
			VAR M23 =
			    IF(
			        E2 > 0 && E3 > 0,
			        MAX(
			            E2 - 1,
			            MAX(
			                E3 - E2 - 1,
			                Largo - E3
			            )
			        ),
			        999
			    )
			
			----------------------------------
			-- COMBINACION E2-E4
			----------------------------------
			
			VAR M24 =
			    IF(
			        E2 > 0 && E4 > 0,
			        MAX(
			            E2 - 1,
			            MAX(
			                E4 - E2 - 1,
			                Largo - E4
			            )
			        ),
			        999
			    )
			
			----------------------------------
			-- COMBINACION E3-E4
			----------------------------------
			
			VAR M34 =
			    IF(
			        E3 > 0 && E4 > 0,
			        MAX(
			            E3 - 1,
			            MAX(
			                E4 - E3 - 1,
			                Largo - E4
			            )
			        ),
			        999
			    )
			
			VAR Mejor =
			    MIN(
			        M12,
			        MIN(
			            M13,
			            MIN(
			                M14,
			                MIN(
			                    M23,
			                    MIN(M24, M34)
			                )
			            )
			        )
			    )
			
			VAR P1 =
			    SWITCH(
			        TRUE(),
			        Mejor = M12, E1,
			        Mejor = M13, E1,
			        Mejor = M14, E1,
			        Mejor = M23, E2,
			        Mejor = M24, E2,
			        E3
			    )
			
			VAR P2 =
			    SWITCH(
			        TRUE(),
			        Mejor = M12, E2,
			        Mejor = M13, E3,
			        Mejor = M14, E4,
			        Mejor = M23, E3,
			        Mejor = M24, E4,
			        E4
			    )
			
			----------------------------------
			-- 3 LINEAS
			----------------------------------
			
			VAR Texto1 =
			    REPLACE(Texto, P2, 1, "|")
			
			VAR Texto2 =
			    REPLACE(Texto1, P1, 1, "|")
			
			VAR Resultado3 =
			    SUBSTITUTE(Texto2, "|", UNICHAR(10))
			
			----------------------------------
			-- RESULTADO
			----------------------------------
			
			RETURN
			    SWITCH(
			        TRUE(),
			        Largo >= Limite3Lineas && P2 > 0, Resultado3,
			        Largo >= Limite2Lineas && Salto2 > 0, Resultado2,
			        Texto
			    )
		lineageTag: 79c6e392-33e2-4448-946e-60813daeac68
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition dim_sucursales = m
		mode: import
		queryGroup: Dims
		source =
				let
				    Origen = Value.NativeQuery(AmazonRedshift.Database("redshift.infra.tcgscout.com","prod"), "SELECT id, internal_code, ""name"", ""chain"", chain_sub_category, country, city, region, sector, ""zone"", company_id, address, latitude, longitude, portrait_image#(lf)FROM northface.vw_branches", null, [EnableFolding=true])
				in
				    Origen

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

